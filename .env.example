# ============================================================
# approval-bot 配置
# ============================================================
# 本项目与所有 qianli 项目共用同一个飞书应用（APP_ID 相同），
# 但功能仅面向审批群（BOT_CHAT_ID），指令与播报均限定在该群。
# ============================================================

# 服务器配置
PORT=3002

# 飞书应用配置（共用应用凭证）
APP_ID=cli_xxxxxxxxxxxx
APP_SECRET=xxxxxxxxxxxxxxxx

# 审批多维表格配置
BITABLE_APP_TOKEN=xxxxxxxxxxxxxxxx
BITABLE_APPROVAL_TABLE_ID=tblXXXXXXXXXXXXXX

# 飞书事件订阅配置
# 长连接模式：true（推荐，无需公网地址）
# 注意：共用应用的多个长连接之间事件是随机分发的，
#       漏掉的事件由 BITABLE_POLL_MINUTES 轮询对账兜底
FEISHU_USE_LONG_CONNECTION=true
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=

# 飞书机器人配置（共用应用机器人的实际名称，用于 @识别）
BOT_NAME=爆米花机_财务型
# 自动播报用的群自定义机器人 Webhook
BOT_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# 本项目唯一服务的目标群 ID（指令与对话触发仅在该群生效）
BOT_CHAT_ID=oc_xxxxxxxxxxxxxxxx

# 活跃审批流程过滤（逗号分隔，只播报这些流程；留空不过滤）
APPROVAL_PROCESS_NAMES=

# 对账轮询间隔（分钟，默认5；事件分发竞争的兜底通道）
BITABLE_POLL_MINUTES=5

# 审批者 open_id 列表（逗号分隔，提醒回落用）
APPROVERS=

# 每周播报（cron 表达式，每周一 18:00）
CRON_SCHEDULE=0 0 18 * * 1

# 每日待审批提醒（每天 09:00，无审批中记录则不发送）
DAILY_INVOICE_REMINDER_SCHEDULE=0 0 9 * * *

# 提醒 @ 目标（逗号分隔 open_id；留空则回落到 HE_YUNJIE_OPEN_ID/ZHANG_GUOHAO_OPEN_ID）
DAILY_REMINDER_MENTION_IDS=
HE_YUNJIE_OPEN_ID=ou_xxxxxxxxxxxxxxxx
ZHANG_GUOHAO_OPEN_ID=ou_xxxxxxxxxxxxxxxx
