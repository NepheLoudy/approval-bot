# ============================================================
# approval-bot 独立飞书应用配置
# ============================================================
# 重要：本项目作为独立的飞书应用运行，必须使用自己的 App ID 和
# App Secret，不要复用 knowledge-tracker 或其他项目的凭证。
# 请先在飞书开放平台 (https://open.feishu.cn) 创建一个新应用，
# 开通权限见 feishu-permissions.json，然后填入以下配置。
# ============================================================

# 服务器配置
PORT=3002

# 飞书应用配置（必填，独立应用凭证）
APP_ID=cli_xxxxxxxxxxxx
APP_SECRET=xxxxxxxxxxxxxxxx

# 飞书多维表格配置（必填）
BITABLE_APP_TOKEN=xxxxxxxxxxxxxxxx
BITABLE_APPROVAL_TABLE_ID=tblXXXXXXXXXXXXXX

# 飞书事件订阅配置
# 长连接模式：true（推荐，无需公网地址）
# Webhook模式：false（需要公网地址，并填入 VERIFICATION_TOKEN）
FEISHU_USE_LONG_CONNECTION=true
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=

# 飞书机器人配置（独立群机器人 webhook）
# 在飞书群聊中添加"自定义机器人"，获取 webhook URL
BOT_NAME=审批机器人
BOT_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# 机器人所在群聊ID（用于通过API主动发消息到群，可选）
BOT_CHAT_ID=oc_xxxxxxxxxxxxxxxx

# 审批者配置（指定成员open_id，逗号分隔，可选）
APPROVERS=ou_xxxxxxxxxxxxxxxx

# 定时播报配置（cron表达式，默认每天18:00）
CRON_SCHEDULE=0 0 18 * * *
