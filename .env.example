# ============================================================
# approval-bot 配置
# ============================================================
# 本项目与所有 qianli 项目共用同一个飞书应用（APP_ID 相同），
# 事件由 feishu-gateway 唯一长连接接收并转发，本服务仅面向
# 审批群（BOT_CHAT_ID），播报为纯定时任务（无事件即时播报）。
# ============================================================

# 服务器配置
PORT=3002

# 飞书应用配置（共用应用凭证）
APP_ID=cli_xxxxxxxxxxxx
APP_SECRET=xxxxxxxxxxxxxxxx

# 租户子域（交付卡等卡内表链接拼前缀；留空默认 https://cquqianli.feishu.cn）
FEISHU_TENANT_BASE_URL=

# 审批多维表格配置
BITABLE_APP_TOKEN=xxxxxxxxxxxxxxxx
BITABLE_APPROVAL_TABLE_ID=tblXXXXXXXXXXXXXX

# 飞书事件订阅配置
# false：事件由 feishu-gateway 转发到 /api/feishu/event（生产模式，推荐）
# true：独立长连接（本地调试用）
FEISHU_USE_LONG_CONNECTION=false
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=

# 飞书机器人配置（共用应用机器人的实际名称，用于 @识别）
BOT_NAME=爆米花机-对话型
# 自动播报用的群自定义机器人 Webhook
BOT_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# 本项目唯一服务的目标群 ID（指令与对话触发仅在该群生效）
BOT_CHAT_ID=oc_xxxxxxxxxxxxxxxx

# 活跃审批流程过滤（逗号分隔，只统计这些流程；留空不过滤）
APPROVAL_PROCESS_NAMES=

# 审批者 open_id 列表（逗号分隔，提醒回落用）
APPROVERS=

# 每周财务催办周报（cron 表达式，每周一 18:00）
# 内容：催发票/催报销单/催转账（完成超3个月）三段 + 底部本周统计
CRON_SCHEDULE=0 0 18 * * 1

# 每日待审批提醒（每天 09:00，无审批中记录则不发送）
DAILY_INVOICE_REMINDER_SCHEDULE=0 0 9 * * *

# 催发票私聊（每天 10:30：已通过满 14 天仍未交发票 → 私聊发起人催交，
# 附「申请编号」自带的审批实例链接，引导到审批详情页补交；留空 = 不启用）
INVOICE_URGE_SCHEDULE=0 30 10 * * *
INVOICE_URGE_GRACE_DAYS=14
INVOICE_URGE_INTERVAL_DAYS=2
# 回复监听：私聊后轮询 p2p 会话消息（不经事件链路）。
# 回复「延期/推迟」→ N 天内不再催该批记录；回复「无法提交」→ 停止催并呈报周报；
# 同一笔私聊满 N 次仍无票 → 停止私聊，周报标注升级给财务
INVOICE_URGE_DEFER_DAYS=3
INVOICE_URGE_MAX_TIMES=5
# 私聊状态持久化文件（JSON）。注意：SFTP 部署会清空项目目录，
# 生产环境务必配到项目目录之外（如 /c/qianli/approval-bot-data/urge-state.json）
INVOICE_URGE_STATE_FILE=

# 提醒 @ 目标（逗号分隔 open_id；留空则回落到下面两个回落审批人 open_id）
DAILY_REMINDER_MENTION_IDS=
REMINDER_FALLBACK_OPEN_ID_1=ou_xxxxxxxxxxxxxxxx
REMINDER_FALLBACK_OPEN_ID_2=ou_xxxxxxxxxxxxxxxx

# ---------------- 发票图像 OCR 转录（飞书官方 OCR，免费） ----------------
# 引擎为飞书开放平台「识别图片中的文字」接口（按区域分段返回文本，单租户 20 QPS，
# 图片 <5MB）；需在飞书后台给共用应用开通「图片识别」(optical_char_recognition)
# 与「获取与上传图片或资源」(im:resource) 两个权限后才能调用
OCR_ENABLED=true
# OCR 请求超时毫秒（base64 大图比普通 API 慢，默认 30000）
OCR_TIMEOUT_MS=30000
# 图片大小上限（字节，飞书限制 5MB）
OCR_MAX_IMAGE_BYTES=5242880
# 字段提取规则文件（JSON，可经 /api/ocr/fields 热改即时生效）。
# 注意：SFTP 部署会清空项目目录，生产环境务必配到项目目录之外
# （如 /c/qianli/approval-bot-data/ocr-fields.json）
OCR_FIELDS_FILE=

# ---------------- 发票采集（私聊/催办回票 → 识别 → 采集台账 → 报销批次） ----------------
# 先跑 node scripts/create-collect-tables.js 建表，再把输出的表 ID 配进来
BITABLE_COLLECT_TABLE_ID=
BITABLE_BATCH_TABLE_ID=
# 审批定义 code（存量回溯用）：飞书审批管理后台 → 打开「采购申请/发票提交」流程 → 详情页获取。
# 不配置时存量回溯端点返回 400 指引（新票采集不受影响）
APPROVAL_CODE=
# 报销抬头校验（可选；逗号分隔多套「名称|税号」，如 重庆大学|50000000XXXXXXXXXX。
# 不配=只记录不校验；购买方名称或税号命中其一即放行，都不命中标「抬头存疑」并打回提醒）
INVOICE_ALLOWED_BUYERS=
# 金额比对容忍：发票价税合计 vs 审批「总金额」，超 max(比例, 固定值) 标「金额不符」（默认 5% / ¥10）
INVOICE_AMOUNT_TOLERANCE_RATIO=0.05
INVOICE_AMOUNT_TOLERANCE_FIXED=10

# ---------------- NAS 部署配置（push.js 用，严禁提交） ----------------
# NAS_* 为历史命名，语义=部署目标（小电脑 DESKTOP-FE1MIGI）
NAS_HOST=192.168.31.57
NAS_PORT=22
NAS_USER=mechax
NAS_PASSWORD=

# ---------------- 晚间静默（播报时段限制） ----------------
# 播报静默窗口 [START, END)（Asia/Shanghai 整点）：窗口内定时/自动播报不直接发送，
# 积压到 END 整点统一补发（任务类重跑取补发时刻数据；一次性通知原样补发）。
# 对话/指令回复与人工当下主动触发不受限。默认 2→9，留空即默认。
# QUIET_HOURS_START=2
# QUIET_HOURS_END=9
# QUIET_HOURS_DISABLED=1
# 静默积压文件（挪项目目录之外，SFTP 部署清目录不再丢积压；目录不存在会自建）
QUIET_BACKLOG_FILE=/c/qianli/approval-bot-data/quiet-backlog.json

# 管理端点鉴权（2026-09-13，全局共享值）：写端点需 X-API-Token 头；未配置 = 写端点锁定
# 生成：openssl rand -hex 24（全工作区共享同一值，运维台代理自动带头）
API_TOKEN=

# ---------------- 报销交付包（锁定批次自动生成：物料清单/投递底单） ----------------
# 摘要拼装：`${BATCH_SUMMARY_PREFIX}-${BATCH_SEASON}-${项目}-${用途}-${BATCH_FEE_TYPE}-第N笔`
# 实例：机甲大师实验室-27赛季-对抗赛-飞镖机器人-材料费-第二十四笔
BATCH_SUMMARY_PREFIX=机甲大师实验室
BATCH_SEASON=27赛季
BATCH_FEE_TYPE=材料费
# 投递单「费用项」/物料清单「采购类型」默认值（lock 可用 费用项=/采购类型= 覆盖）
BATCH_FEE_ITEM=实验室用品
BATCH_PURCHASE_TYPE=机器人零件
# 物料清单「制单人」（留空回落报销人姓名）
BATCH_PREPARER_NAME=
# 报销人信息（投递单抬头；缺失项底单标黄，录入小翼Plus 时人工补）
CQ_REPORTER_STU_ID=
CQ_REPORTER_NAME=
CQ_REPORTER_PHONE=
# 学校经费项目卡
CQ_PROJECT_CODE=
CQ_PROJECT_NAME=
CQ_PROJECT_DEPT=
CQ_PROJECT_LEADER=
# 转卡收款账户（敏感！只存本文件随 push 下发，严禁进 git/截图）
CQ_BANK_CARD_NO=
CQ_BANK_NAME=

# ---------------- 报销台账电子表格同步（v50） ----------------
# 《报销台账》飞书 Sheets：submit 追加行（摘要/金额/收款人自动填，投递单号可留空财务补），
# paid 回填入账日期+已到账，reject 标记已退回。行匹配=批次摘要精确等值，绝不改别人的行。
# 留空 = 同步关闭。
LEDGER_SPREADSHEET_TOKEN=
LEDGER_SHEET_ID=
